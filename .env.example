# Copia in .env.local per lo sviluppo locale. Su Vercel imposta le stesse variabili
# in Settings → Environment Variables (ogni modifica richiede un nuovo deploy).

# Form contatti (Web3Forms). Chiave PUBBLICA by design: finisce nel bundle client.
# Se vuota, il form è sostituito dal solo link mailto.
# Ambienti Vercel: Production, Preview, Development
NEXT_PUBLIC_WEB3FORMS_KEY=

# Login al CMS /admin (GitHub OAuth App). SEGRETE: mai committarle.
# Ambienti Vercel: Production (il CMS funziona solo sul dominio di produzione)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Opzionale: URL canonico del sito. Su Vercel non serve (si usa in automatico
# VERCEL_PROJECT_PRODUCTION_URL); utile solo per forzare un dominio diverso.
# NEXT_PUBLIC_SITE_URL=https://www.esempio.it
